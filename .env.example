# ==============================================================================
# MANDARIN REYS HISOBOTI - ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- DATABASE CONFIGURATION ---
# Neon PostgreSQL Connection String (foydalanuvchi va parol bilan birga):
# Neon bepul tarifida PgBouncer bilan ishlash uchun "-pooler" manzilidan foydalaning.
# Bo'sh qoldirilsa avtomatik tarzda lokal SQLite (data/reys.db) ishlatiladi.
DATABASE_URL=postgresql://user:password@ep-sample-pooler.eu-central-1.neon.tech/neondb?sslmode=require

# --- AUTH & SECURITY ---
# Web panel va API boshqaruvi uchun admin paroli (kamida 8 ta belgi):
ADMIN_PASSWORD=change_this_strong_password
# Sessiya amal qilish muddati (soniyalarda, standart: 30 kun = 2592000 sek):
SESSION_TTL=2592000

# --- TELEGRAM BOT & OUTBOX CHANNELS ---
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ_your_bot_token

# 5 ta alohida Telegram kanali ID lari (-100 bilan boshlanadi):
# 1. Kargolarga tarqatish va Reyslar:
BOT_KARGOLARGA_TARQATISH_CHANNEL_ID=-1001234567890
# 2. TOP tovar turi:
BOT_TOP_TYPE_CHANNEL_ID=-1001234567891
# 3. TOPdan chiqgan:
BOT_TOPDAN_CHIQGAN_CHANNEL_ID=-1001234567892
# 4. Bizda qoladigan:
BOT_BIZDA_QOLADIGAN_CHANNEL_ID=-1001234567893
# 5. Bizdan chiqgan:
BOT_BIZDAN_CHIQGAN_CHANNEL_ID=-1001234567894

# --- PHOTO STORAGE CONFIGURATION (CLOUDFLARE R2 / DISK) ---
# Saqlash usuli: 'r2' yoki 'disk' (standart: disk)
# Neon PostgreSQL 500 MB limitini tejash uchun rasmlar bulutda yoki diskda saqlanadi.
PHOTO_STORAGE_BACKEND=disk

# Agar PHOTO_STORAGE_BACKEND=r2 bo'lsa quyidagilarni to'ldiring:
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=mandarin-photos
CLOUDFLARE_R2_PREFIX=production
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://photos.yourdomain.com

# --- WEBAPP / FRONTEND ---
WEBAPP_URL=http://localhost:5173
PORT=8000
